{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "ink-black",
					"color": "#1a1a1a",
					"name": "Ink Black"
				},
				{
					"slug": "charcoal",
					"color": "#333333",
					"name": "Charcoal"
				},
				{
					"slug": "mid-gray",
					"color": "#646464",
					"name": "Mid Gray"
				},
				{
					"slug": "light-gray",
					"color": "#999999",
					"name": "Light Gray"
				},
				{
					"slug": "border",
					"color": "#e5e5e5",
					"name": "Border"
				},
				{
					"slug": "off-white",
					"color": "#f8f8f8",
					"name": "Off White"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "footer-dark",
					"color": "#1b1d1f",
					"name": "Footer Dark"
				},
				{
					"slug": "footer-deep",
					"color": "#111111",
					"name": "Footer Deep"
				}
			],
			"gradients": [],
			"defaultPalette": false,
			"defaultGradients": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Playfair Display', Georgia, 'Times New Roman', serif",
					"slug": "display",
					"name": "Display (Playfair Display)"
				},
				{
					"fontFamily": "'Source Sans Pro', 'Helvetica Neue', Arial, sans-serif",
					"slug": "body",
					"name": "Body (Source Sans Pro)"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "14px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "16px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "20px",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "24px",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "32px",
					"name": "2X Large"
				},
				{
					"slug": "xxx-large",
					"size": "42px",
					"name": "3X Large"
				}
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ],
			"spacingSizes": [
				{
					"slug": "10",
					"size": "8px",
					"name": "XS"
				},
				{
					"slug": "20",
					"size": "16px",
					"name": "SM"
				},
				{
					"slug": "30",
					"size": "24px",
					"name": "MD"
				},
				{
					"slug": "40",
					"size": "40px",
					"name": "LG"
				},
				{
					"slug": "50",
					"size": "64px",
					"name": "XL"
				},
				{
					"slug": "60",
					"size": "96px",
					"name": "XXL"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#333333"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "16px",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "24px"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				},
				"color": {
					"text": "#1a1a1a"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "42px",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "32px",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "24px",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "20px",
					"lineHeight": "1.35"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "16px",
					"lineHeight": "1.4",
					"textTransform": "uppercase",
					"letterSpacing": "1.5px"
				}
			},
			"link": {
				"color": {
					"text": "#1a1a1a"
				},
				":hover": {
					"color": {
						"text": "#646464"
					}
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "#1a1a1a"
						},
						":hover": {
							"color": {
								"text": "#646464"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "24px",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "#1a1a1a"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "13px",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "1px"
				},
				"color": {
					"text": "#646464"
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "12px",
					"textTransform": "uppercase",
					"letterSpacing": "1.5px"
				},
				"color": {
					"text": "#999999"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "11px",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "1.5px"
				},
				"color": {
					"text": "#999999"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "15px",
					"lineHeight": "1.65"
				},
				"color": {
					"text": "#646464"
				}
			},
			"core/separator": {
				"color": {
					"text": "#e5e5e5"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontStyle": "italic"
				},
				"border": {
					"left": {
						"color": "#1a1a1a",
						"width": "3px",
						"style": "solid"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "home",
			"title": "Homepage (Photo Grid)",
			"postTypes": [ "page" ]
		},
		{
			"name": "blog-grid",
			"title": "Blog Grid",
			"postTypes": [ "page" ]
		}
	]
}

{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1a1f2e"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#fbf9f4"
				},
				{
					"slug": "tide",
					"name": "Tide",
					"color": "#1f6b7a"
				},
				{
					"slug": "driftwood",
					"name": "Driftwood",
					"color": "#a08268"
				},
				{
					"slug": "sun",
					"name": "Sun",
					"color": "#e8a13a"
				},
				{
					"slug": "shell",
					"name": "Shell",
					"color": "#f0e7d8"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "serif-display",
					"name": "Serif Display",
					"fontFamily": "\"Fraunces\", \"Iowan Old Style\", Georgia, serif"
				},
				{
					"slug": "sans-reading",
					"name": "Sans Reading",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans-reading)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif-display)",
					"fontWeight": "500"
				}
			},
			"h1": {
				"typography": {
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"lineHeight": "1.15"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--tide)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--driftwood)"
					}
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--tide)",
						"width": "3px",
						"style": "solid"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif-display)",
					"fontStyle": "italic"
				}
			}
		}
	}
}
